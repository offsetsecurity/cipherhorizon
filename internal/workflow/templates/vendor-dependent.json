{
  "id": "vendor-dependent",
  "version": 1,
  "title": "Vendor-dependent change",
  "purpose": "A change only a supplier can deliver: record the request to the vendor, wait for it with an end date, apply it, and close.",
  "subjects": ["system", "endpoint", "finding", "certificate", "readiness"],
  "stages": [
    {"id": "requested", "label": "Requested", "marker": "requested"},
    {"id": "asked", "label": "Vendor asked"},
    {"id": "waiting", "label": "Waiting for the vendor", "marker": "exception"},
    {"id": "delivered", "label": "Vendor delivered"},
    {"id": "applied", "label": "Applied", "marker": "executed"},
    {"id": "closed", "label": "Closed", "marker": "complete", "terminal": true},
    {"id": "cancelled", "label": "Cancelled", "marker": "cancelled", "terminal": true}
  ],
  "transitions": [
    {"id": "ask", "label": "Record the request to the vendor", "from": ["requested"], "to": "asked", "require": ["evidence"]},
    {"id": "wait", "label": "Wait until a date", "from": ["asked"], "to": "waiting", "role": "admin", "require": ["note", "until"]},
    {"id": "deliver", "label": "Vendor delivered", "from": ["asked", "waiting"], "to": "delivered", "require": ["evidence"]},
    {"id": "apply", "label": "Record that it is applied", "from": ["delivered"], "to": "applied", "require": ["note"]},
    {"id": "close", "label": "Close", "from": ["applied"], "to": "closed"},
    {"id": "cancel", "label": "Cancel", "from": ["requested", "asked", "waiting", "delivered"], "to": "cancelled", "require": ["note"]}
  ]
}
