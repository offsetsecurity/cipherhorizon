# CipherHorizon service settings, read by systemd (cipherhorizon.service). Package upgrades keep
# your changes to this file. Apply them with:  sudo systemctl restart cipherhorizon

# Extra "cipherhorizon serve" options, separated by spaces (cipherhorizon serve --help lists them).
# The service listens on 127.0.0.1:8080 and keeps its database in /var/lib/cipherhorizon; options
# given here come after those, so --addr here replaces the address. Examples:
#   CIPHERHORIZON_OPTS="--port 9000"
#   CIPHERHORIZON_OPTS="--sign-in on"
#   CIPHERHORIZON_OPTS="--sign-in on --addr 0.0.0.0:8443 --tls-cert /etc/cipherhorizon/tls.crt --tls-key /etc/cipherhorizon/tls.key"
CIPHERHORIZON_OPTS=""

# An automation token for scripts and CI (at least 32 characters; openssl rand -hex 24).
CIPHERHORIZON_TOKEN=""
